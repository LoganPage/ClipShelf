<Application x:Class="ClipShelf.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClipShelf" xmlns:documents="clr-namespace:System.Windows.Documents;assembly=PresentationFramework" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="FluentMenus.xaml"/><ResourceDictionary Source="RecordIcons.xaml"/></ResourceDictionary.MergedDictionaries>
   <!-- Windows geometry: persistent controls / transient overlays / touching edges. -->
   <CornerRadius x:Key="ControlCorners">4</CornerRadius>
   <CornerRadius x:Key="OverlayCorners">8</CornerRadius>
   <CornerRadius x:Key="SquareCorners">0</CornerRadius>
   <SolidColorBrush x:Key="BackgroundBrush" Color="#F6F7F9"/>
   <SolidColorBrush x:Key="SurfaceBrush" Color="White"/>
   <SolidColorBrush x:Key="SearchBrush" Color="White"/>
   <SolidColorBrush x:Key="SettingsBrush" Color="White"/>
   <SolidColorBrush x:Key="TextBrush" Color="#242830"/>
   <SolidColorBrush x:Key="MutedBrush" Color="#737985"/>
   <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C7CC"/>
   <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#858B94"/>
   <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#555D68"/>
   <SolidColorBrush x:Key="BorderBrush" Color="#D6D9E0"/>
   <SolidColorBrush x:Key="SelectedBrush" Color="#E8EFF7"/>
   <SolidColorBrush x:Key="ActionBrush" Color="#E9EBEF"/>
   <SolidColorBrush x:Key="HoverBrush" Color="#E1E5EB"/>
   <SolidColorBrush x:Key="AccentBrush" Color="#2870DB"/>
   <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#FAFAFA"/>
   <SolidColorBrush x:Key="MenuBorderBrush" Color="#DCDCDC"/>
   <SolidColorBrush x:Key="MenuHoverBrush" Color="#EDEDED"/>
   <SolidColorBrush x:Key="MenuDividerBrush" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="TextTileBrush" Color="#E6F2FA"/>
   <SolidColorBrush x:Key="TextTileForeground" Color="#1A526B"/>
   <SolidColorBrush x:Key="FileTileBrush" Color="#E8F5EB"/>
   <SolidColorBrush x:Key="FileTileForeground" Color="#1F6133"/>
   <SolidColorBrush x:Key="ImageTileBrush" Color="#FAF0E0"/>
   <SolidColorBrush x:Key="ImageTileForeground" Color="#8F4D0A"/>
   <!-- Adorners are outside their target's subtree: read intent and actual focus
        from AdornedElement so stale/background adorners can never light up. -->
   <Style x:Key="FocusCueBorder" TargetType="Border">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
     <Condition Binding="{Binding AdornedElement.(local:FocusCuePolicy.ShowKeyboardFocus), RelativeSource={RelativeSource AncestorType={x:Type documents:Adorner}}}" Value="True"/>
     <Condition Binding="{Binding AdornedElement.IsKeyboardFocused, RelativeSource={RelativeSource AncestorType={x:Type documents:Adorner}}}" Value="True"/>
    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
   </Style>
   <Style x:Key="KeyboardFocusVisual" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border Style="{StaticResource FocusCueBorder}" Margin="2" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlCorners}" SnapsToDevicePixels="True" IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter></Style>
   <!-- Selection fill is sufficient when arrow navigation selects the row.
        A small neutral tick only identifies focus-only navigation (Ctrl+arrows)
        on an unselected row; history never draws a rectangular focus outline. -->
   <Style x:Key="RowFocusCueMarker" TargetType="Border" BasedOn="{StaticResource FocusCueBorder}">
    <Style.Triggers><DataTrigger Binding="{Binding AdornedElement.IsSelected, RelativeSource={RelativeSource AncestorType={x:Type documents:Adorner}}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
   </Style>
   <Style x:Key="RowKeyboardFocusVisual" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border Style="{StaticResource RowFocusCueMarker}" Width="2" HorizontalAlignment="Left" Margin="4,6,0,6" Background="{DynamicResource MutedBrush}" BorderThickness="0" CornerRadius="{DynamicResource SquareCorners}" SnapsToDevicePixels="True" IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="Window"><Setter Property="local:FocusCuePolicy.IsEnabled" Value="True"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/></Style>
   <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
   <Style TargetType="Button" x:Key="SoftButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
    <Setter Property="Background" Value="{DynamicResource ActionBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCorners}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.32"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource SoftButton}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
   <Style TargetType="Button" x:Key="ToolbarButton" BasedOn="{StaticResource IconButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0"/></Style>
   <Style TargetType="Button" x:Key="CaptionButton">
    <Setter Property="Width" Value="46"/><Setter Property="Height" Value="30"/><Setter Property="FontSize" Value="10"/>
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.65"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="CloseCaption"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="surface" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></MultiTrigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger></Style.Triggers>
   </Style>
   <Style TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
   <Style TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
    <Setter Property="MinHeight" Value="29"/><Setter Property="MinWidth" Value="150"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
     <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource ActionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCorners}"/></ControlTemplate></ToggleButton.Template></ToggleButton>
     <ContentPresenter Margin="9,5,28,5" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" VerticalAlignment="Center"/>
     <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource SettingsBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource OverlayCorners}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="8,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="item" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCorners}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="item" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
     <Border Background="Transparent"><Border x:Name="Grip" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="1,0"/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/></Trigger>
      <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource ScrollThumbDragBrush}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="9"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value>
     <ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" Margin="1,4"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
     </Track></Grid></ControlTemplate>
    </Setter.Value></Setter>
   </Style>
   <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource SearchBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCorners}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" Focusable="False"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
    <Setter Property="MinHeight" Value="32"/><Setter Property="Background" Value="{DynamicResource SettingsControlBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCorners}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SettingsHoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="local:SmoothScrollViewer">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:SmoothScrollViewer">
     <Grid Background="{TemplateBinding Background}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
      <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="9" MinWidth="0" Margin="0,3,2,3" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Focusable="False"/>
     </Grid>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <!-- A CheckBox peer retains the native accessible toggle state and Space/Tab behavior. -->
   <Style x:Key="SettingsToggle" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="MinHeight" Value="36"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
     <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <TextBlock x:Name="state" Grid.Column="1" Text="关" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource SettingsSecondaryBrush}"/>
      <Border x:Name="track" Grid.Column="2" Width="40" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource SettingsSecondaryBrush}" Background="{DynamicResource ToggleOffBrush}" VerticalAlignment="Center">
       <Ellipse x:Name="knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource ToggleKnobBrush}"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
      </Border>
     </Grid>
     <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="knob" Property="Fill" Value="{DynamicResource OnAccentBrush}"/><Setter TargetName="state" Property="Text" Value="开"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="track" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
