{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipshelf.dev/sync/v1/schema/ack.schema.json",
  "title": "ClipShelf Sync Protocol v1 ACK",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "properties": {
        "messageType": { "const": "ack" },
        "body": {
          "type": "object",
          "required": ["originDeviceId", "acceptedThroughSequence"],
          "properties": {
            "originDeviceId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
            "acceptedThroughSequence": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
