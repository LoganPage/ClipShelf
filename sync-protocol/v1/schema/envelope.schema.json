{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipshelf.dev/sync/v1/schema/envelope.schema.json",
  "title": "ClipShelf Sync Protocol v1 Envelope",
  "type": "object",
  "required": ["protocolVersion", "messageType", "messageId", "sentAtUtc", "body"],
  "properties": {
    "protocolVersion": { "type": "integer", "const": 1 },
    "messageType": { "type": "string", "enum": ["hello", "textEvent", "ack", "error"] },
    "messageId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
    "sentAtUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "body": { "type": "object" }
  },
  "additionalProperties": true
}
