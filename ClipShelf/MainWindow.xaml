<Window x:Class="ClipShelf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClipShelf" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="ClipShelf" Width="720" Height="572" MinWidth="680" MinHeight="552" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Window_KeyDown">
 <!-- Nonzero glass selects DWM composition instead of resetting a legacy HWND region on every resize. The opaque client background still covers the glass. -->
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <DataTemplate x:Key="PinGlyphTemplate">
   <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Canvas.RenderTransform><RotateTransform Angle="35" CenterX="12" CenterY="12"/></Canvas.RenderTransform>
    <Path x:Name="PinHead" Data="M7,3 L17,3 15,6 15,11 19,15 5,15 9,11 9,6 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
    <Path Data="M12,15 L12,22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeEndLineCap="Round"/>
   </Canvas></Viewbox>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Pinned"><Setter TargetName="PinHead" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTrigger>
    <DataTrigger Binding="{Binding DataContext.IsPinned, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter TargetName="PinHead" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <!-- Shared ControlCorners / OverlayCorners are defined once in App.xaml. -->
  <ControlTemplate x:Key="HistoryScrollTemplate" TargetType="ScrollViewer">
   <Grid Background="Transparent" ClipToBounds="True">
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="0"/>
    <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,3,0,3" Width="13" MinWidth="0" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Focusable="False"/>
   </Grid>
  </ControlTemplate>
 </Window.Resources>
 <!-- DWM owns the only outer contour. Never stack an unrelated client-side radius over it. -->
 <Border x:Name="WindowFrame" BorderThickness="0" CornerRadius="0" Padding="1" Background="{DynamicResource BackgroundBrush}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <Ellipse x:Name="WindowFocusLight" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" AutomationProperties.Name="窗口焦点状态">
    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#92989F"/><Setter Property="ToolTip" Value="窗口未聚焦"/><Style.Triggers><DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Fill" Value="#32B96B"/><Setter Property="ToolTip" Value="窗口已聚焦"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
   </Ellipse>
   <TextBlock Text="ClipShelf" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化" Click="Minimize_Click"/>
    <Button ToolTip="最大化 / 还原" AutomationProperties.Name="最大化 / 还原" Click="Maximize_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="Content" Value="&#xE922;"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Content" Value="&#xE923;"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button Style="{StaticResource CaptionButton}" Tag="CloseCaption" Content="&#xE8BB;" ToolTip="关闭（行为可在设置中选择）" AutomationProperties.Name="关闭" Click="Hide_Click"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel x:Name="HeaderPanel" Margin="18,14,18,6">
    <Grid Height="40">
     <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Image x:Name="AppImage" Width="36" Height="36" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="ClipShelf" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="正在准备剪贴板记录…" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE8B7;" ToolTip="选择截图文件夹" AutomationProperties.Name="选择截图文件夹" Click="Folder_Click"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE713;" ToolTip="设置" AutomationProperties.Name="设置" Click="Settings_Click"/>
      <Button x:Name="CopyButton" Style="{StaticResource ToolbarButton}" Content="&#xE8C8;" ToolTip="复制当前记录 · Ctrl+C" AutomationProperties.Name="复制选中记录" Click="Copy_Click"/>
      <Button x:Name="PinButton" Style="{StaticResource ToolbarButton}" Content="&#xE718;" ContentTemplate="{StaticResource PinGlyphTemplate}" ToolTip="置顶选中的记录" AutomationProperties.Name="置顶选中记录" Click="Pin_Click"/>
      <Button x:Name="DeleteButton" Style="{StaticResource ToolbarButton}" Content="&#xE74D;" ToolTip="删除选中记录 · Delete" AutomationProperties.Name="删除选中记录" Click="Delete_Click"/>
      <Button x:Name="UndoDeleteButton" Style="{StaticResource ToolbarButton}" Content="&#xE7A7;" ToolTip="撤销删除 · Ctrl+Z" AutomationProperties.Name="撤销删除" Click="UndoDelete_Click"/>
     </StackPanel>
    </Grid>
    <local:RoundedClipBorder x:Name="SearchBorder" Margin="0,12,0,0" Background="{DynamicResource SearchBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCorners}" Padding="12,8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
      <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Padding="0" FontSize="13" Background="Transparent" TextChanged="Search_Changed" AutomationProperties.Name="搜索文字、文件名、截图名"/>
      <TextBlock x:Name="SearchPlaceholder" Text="搜索文字、文件名、截图名" Grid.Column="1" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center"/>
      <Border x:Name="SelectionBadge" Grid.Column="2" Visibility="Hidden" Background="{DynamicResource SelectedBrush}" CornerRadius="{DynamicResource ControlCorners}" Padding="8,2" Margin="6,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock x:Name="SelectionCountText" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource TextBrush}" AutomationProperties.LiveSetting="Polite"/></Border>
      <Button Grid.Column="3" Style="{StaticResource ToolbarButton}" Width="24" Height="20" Content="&#xE894;" FontSize="10" ToolTip="清除搜索" AutomationProperties.Name="清除搜索" Click="ClearSearch_Click"/>
     </Grid>
    </local:RoundedClipBorder>
   </StackPanel>
   <Grid Grid.Row="1" Margin="18,8,18,18">
    <local:RoundedClipBorder x:Name="HistoryBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCorners}" PreviewMouseLeftButtonDown="History_MouseDown" PreviewMouseMove="History_MouseMove" PreviewMouseLeftButtonUp="History_MouseUp" LostMouseCapture="History_LostCapture" PreviewMouseWheel="History_DragMouseWheel">
     <local:HistoryListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}" SelectionMode="Extended" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,1" ScrollViewer.PanningMode="VerticalOnly" SelectionChanged="History_SelectionChanged" AutomationProperties.Name="剪贴板历史记录">
      <ListBox.Template><ControlTemplate TargetType="local:HistoryListBox"><ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" Padding="0" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Template="{StaticResource HistoryScrollTemplate}"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{StaticResource RowKeyboardFocusVisual}"/><Setter Property="AutomationProperties.Name" Value="{Binding DisplayTitle}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding KindLabel}"/><Setter Property="local:SelectionRowMotion.IsEnabled" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True"><Border x:Name="RowBg" CornerRadius="{DynamicResource SquareCorners}" Background="{DynamicResource SelectedBrush}" Opacity="0" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/><Border x:Name="RowSeparator" Height="1" Margin="76,0,12,0" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom" Opacity="0.45" IsHitTestVisible="False"/></Grid></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate DataType="{x:Type local:ClipItem}">
       <local:CachedHistoryRow Height="74" Margin="12,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <local:RoundedClipBorder x:Name="Tile" Width="52" Height="40" HorizontalAlignment="Left" CornerRadius="{DynamicResource ControlCorners}" Background="{DynamicResource TextTileBrush}" VerticalAlignment="Center" ClipToBounds="True">
         <Grid><local:RecordTypeIcon x:Name="TypeIcon" Item="{Binding}" Palette="{DynamicResource TextBrush}" ToolTip="{Binding KindLabel}"><local:RecordTypeIcon.Style><Style TargetType="local:RecordTypeIcon"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:RecordTypeIcon.Style></local:RecordTypeIcon><Image x:Name="Thumbnail" local:ThumbnailLoader.Path="{Binding ImagePath}" Visibility="Collapsed" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
        </local:RoundedClipBorder>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
         <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" LineHeight="18"/>
         <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding TimeLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
         <Button x:Name="RowPinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ContentTemplate="{StaticResource PinGlyphTemplate}" Tag="Pin" ToolTip="置顶此记录" AutomationProperties.Name="置顶此记录" Click="RowAction_Click"/>
         <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Tag="Copy" ToolTip="复制" AutomationProperties.Name="复制此记录" Click="RowAction_Click"/>
         <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Tag="Delete" ToolTip="删除记录" AutomationProperties.Name="删除此记录" Margin="0" Click="RowAction_Click"/>
        </StackPanel>
       </local:CachedHistoryRow>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="File"><Setter TargetName="Tile" Property="Background" Value="Transparent"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Image"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource ImageTileBrush}"/><Setter TargetName="Thumbnail" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter TargetName="RowPinButton" Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="RowPinButton" Property="ToolTip" Value="取消置顶此记录"/><Setter TargetName="RowPinButton" Property="AutomationProperties.Name" Value="取消置顶此记录"/></DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate></ListBox.ItemTemplate>
     </local:HistoryListBox>
    </local:RoundedClipBorder>
    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" Foreground="{DynamicResource MutedBrush}" Opacity="0.5" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="还没有历史记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/><TextBlock x:Name="EmptyDetail" Text="复制文字、文件或图片后，会显示在这里。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
   </Grid>
   <Border x:Name="Toast" Panel.ZIndex="30" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="18" Background="{DynamicResource TextBrush}" CornerRadius="{DynamicResource OverlayCorners}" Padding="16,10" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="ToastText" Foreground="{DynamicResource SurfaceBrush}" TextWrapping="Wrap" MaxWidth="540"/></Border>
   <Grid x:Name="SettingsOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#40000000" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained" FocusManager.IsFocusScope="True" MouseDown="Overlay_MouseDown">
    <!-- A static sibling owns the shadow: scrolling controls never render through an effect surface. -->
    <Border x:Name="SettingsShadow" Margin="48" MinWidth="560" MaxWidth="760" CornerRadius="{DynamicResource OverlayCorners}" Background="{DynamicResource SettingsCanvasBrush}" IsHitTestVisible="False"><Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.18"/></Border.Effect></Border>
    <local:RoundedClipBorder x:Name="SettingsCard" Margin="48" MinWidth="560" MaxWidth="760" CornerRadius="{DynamicResource OverlayCorners}" BorderBrush="{DynamicResource SettingsStrokeBrush}" BorderThickness="1" Background="{DynamicResource SettingsCanvasBrush}" Padding="0" MouseDown="Card_MouseDown"><ContentControl x:Name="SettingsContent"/></local:RoundedClipBorder>
   </Grid>
  </Grid>
 </Grid>
 </Border>
</Window>
